    "The active location session ended before the walk finished.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة الموقع النشطة قبل انتهاء المشي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de localisation active s’est terminée avant la fin de la marche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktive Standortsitzung endete, bevor das Gehen abgeschlossen war."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סשן המיקום הפעיל הסתיים לפני שההליכה הסתיימה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォーキングが終わる前に、有効な位置情報セッションが終了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步行结束前，当前的定位会话已结束。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de ubicación activa terminó antes de que acabara la caminata."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "步行結束前，目前的定位工作階段已結束。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên vị trí đang hoạt động đã kết thúc trước khi hoàn tất đi bộ."
          }
        }
      }
    },
    "The active location session ended unexpectedly.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت جلسة الموقع النشطة بشكل غير متوقع."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de localisation active s’est terminée de façon inattendue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktive Standortsitzung wurde unerwartet beendet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סשן המיקום הפעיל הסתיים באופן בלתי צפוי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な位置情報セッションが予期せず終了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前的定位会话意外结束。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de ubicación activa terminó inesperadamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的定位工作階段意外結束。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên vị trí đang hoạt động đã kết thúc đột ngột."
          }
        }
      }
    },
    "The code is generated on this iPhone and expires with this pairing attempt.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إنشاء الرمز على هذا الـ iPhone وتنتهي صلاحيته مع محاولة الإقران هذه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code est généré sur cet iPhone et expire avec cette tentative d’association."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code wird auf diesem iPhone erzeugt und läuft mit diesem Kopplungsversuch ab."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד נוצר ב‑iPhone הזה ותוקפו פג עם ניסיון הצימוד הזה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードはこのiPhoneで生成され、今回のペアリング操作とともに無効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码在这台 iPhone 上生成，并在本次配对尝试结束时失效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código se genera en este iPhone y caduca con este intento de emparejamiento."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代碼在這部 iPhone 上產生，並於本次配對嘗試結束時失效。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã được tạo trên iPhone này và hết hạn cùng lần ghép đôi này."
          }
        }
      }
    },
    "The destination remains active until you stop and restore your real location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل الوجهة نشطة حتى توقف الجلسة وتستعيد موقعك الحقيقي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destination reste active jusqu’à ce que vous arrêtiez et restauriez votre position réelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel bleibt aktiv, bis Sie beenden und Ihren echten Standort wiederherstellen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היעד נשאר פעיל עד שתעצור ותשחזר את המיקום האמיתי שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止して実際の位置情報を復元するまで、目的地は有効なままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您停止并恢复真实位置之前，目的地将保持生效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El destino permanece activo hasta que detengas y restaures tu ubicación real."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您停止並恢復真實位置之前，目的地將保持生效。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm đến vẫn hoạt động cho đến khi bạn dừng và khôi phục vị trí thật."
          }
        }
      }
    },
    "The generated pairing identity was not valid.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هوية الإقران التي تم إنشاؤها غير صالحة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identité d’association générée n’était pas valide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erzeugte Kopplungsidentität war ungültig."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהות הצימוד שנוצרה לא הייתה תקינה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
