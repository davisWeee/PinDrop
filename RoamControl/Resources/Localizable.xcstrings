    "The secure location session is ready. You can restore mobile data now; spoofing will continue over 5G.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة الموقع الآمنة جاهزة. يمكنك الآن إعادة تشغيل بيانات الجوال؛ وسيستمر تغيير الموقع عبر 5G."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de localisation sécurisée est prête. Vous pouvez réactiver les données mobiles ; la simulation continuera en 5G."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sichere Standortsitzung ist bereit. Sie können mobile Daten jetzt wieder einschalten; die Simulation läuft über 5G weiter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סשן המיקום המאובטח מוכן. אפשר להפעיל עכשיו את הנתונים הסלולריים; הדמיית המיקום תימשך דרך 5G."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な位置情報セッションの準備ができました。モバイルデータをオンに戻せます。位置のシミュレーションは5G経由で続行されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
