    "Find a place by name or enter latitude and longitude. Choosing a result also clears the search ready for the next one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن مكان بالاسم أو أدخل خط العرض وخط الطول. يؤدي اختيار نتيجة أيضًا إلى مسح البحث استعدادًا للبحث التالي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez un lieu par son nom ou saisissez latitude et longitude. Choisir un résultat efface aussi la recherche, prête pour la suivante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie einen Ort per Name oder geben Sie Breiten- und Längengrad ein. Nach der Auswahl eines Ergebnisses wird die Suche für die nächste geleert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצא מקום לפי שם או הזן קו רוחב וקו אורך. בחירת תוצאה גם מנקה את החיפוש לקראת החיפוש הבא."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所を名前で探すか、緯度と経度を入力します。結果を選ぶと、次の検索のために検索欄もクリアされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按名称查找地点，或输入纬度和经度。选择结果后，搜索栏会清空，方便进行下一次搜索。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra un lugar por nombre o introduce latitud y longitud. Al elegir un resultado también se borra la búsqueda para la siguiente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依名稱尋找地點，或輸入緯度和經度。選擇結果後，搜尋欄會清空，方便進行下一次搜尋。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm địa điểm theo tên hoặc nhập vĩ độ và kinh độ. Chọn một kết quả cũng sẽ xóa ô tìm kiếm để sẵn sàng cho lần sau."
          }
        }
      }
    },
