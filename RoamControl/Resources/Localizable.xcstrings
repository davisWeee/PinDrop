    "Local Network access is required to find this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الشبكة المحلية مطلوب للعثور على هذا الـ iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au réseau local est requis pour trouver cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Finden dieses iPhone ist der Zugriff auf das lokale Netzwerk erforderlich."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשת גישה לרשת המקומית כדי למצוא את ה‑iPhone הזה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneを見つけるには、ローカルネットワークへのアクセスが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找这台 iPhone 需要“本地网络”访问权限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso a la red local para encontrar este iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找這部 iPhone 需要「本機網路」取用權限。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền truy cập Mạng cục bộ để tìm iPhone này."
          }
        }
      }
    },
    "Local Network access is required. Enable it in Settings › Apps › PinDrop, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الشبكة المحلية مطلوب. فعّله في الإعدادات ‹ التطبيقات ‹ PinDrop ثم حاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au réseau local est requis. Activez-le dans Réglages › Apps › PinDrop, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf das lokale Netzwerk ist erforderlich. Aktivieren Sie ihn unter Einstellungen › Apps › PinDrop und versuchen Sie es erneut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשת גישה לרשת המקומית. הפעל אותה ב‑הגדרות › אפליקציות › PinDrop ונסה שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークへのアクセスが必要です。「設定」›「App」›「PinDrop」で有効にして、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要“本地网络”访问权限。请在“设置”›“App”›“PinDrop”中启用，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso a la red local. Actívalo en Ajustes › Apps › PinDrop e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要「本機網路」取用權限。請在「設定」›「App」›「PinDrop」中啟用，然後再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền truy cập Mạng cục bộ. Hãy bật trong Cài đặt › Ứng dụng › PinDrop rồi thử lại."
          }
        }
      }
    },
    "Local Network access is unavailable. Allow it in iPhone Settings, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الشبكة المحلية غير متاح. اسمح به في إعدادات الـ iPhone ثم حاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au réseau local est indisponible. Autorisez-le dans les Réglages de l’iPhone, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf das lokale Netzwerk ist nicht verfügbar. Erlauben Sie ihn in den iPhone-Einstellungen und versuchen Sie es erneut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה לרשת המקומית אינה זמינה. אפשר אותה בהגדרות ה‑iPhone ונסה שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワークへのアクセスを利用できません。iPhoneの設定で許可してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“本地网络”访问不可用。请在 iPhone 的“设置”中允许，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la red local no está disponible. Permítelo en los Ajustes del iPhone e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「本機網路」取用不可用。請在 iPhone 的「設定」中允許，然後再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có quyền truy cập Mạng cục bộ. Hãy cho phép trong Cài đặt iPhone rồi thử lại."
          }
        }
      }
    },
    "LocalDevVPN": {
      "extractionState": "manual",
      "localizations": {
