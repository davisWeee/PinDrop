    "Pairing took too long. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق الإقران وقتًا طويلًا. يرجى المحاولة مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’association a pris trop de temps. Veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopplung hat zu lange gedauert. Bitte versuchen Sie es erneut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצימוד נמשך זמן רב מדי. נסה שוב."
