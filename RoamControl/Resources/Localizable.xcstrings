    "Move an active location session to a newly selected place without restarting the whole connection flow.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل جلسة موقع نشطة إلى مكان جديد دون إعادة تشغيل عملية الاتصال بأكملها."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez une session de localisation active vers un nouveau lieu sans relancer toute la connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlegen Sie eine aktive Standortsitzung an einen neu gewählten Ort, ohne den gesamten Verbindungsablauf neu zu starten."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העבר סשן מיקום פעיל למקום חדש שנבחר בלי להפעיל מחדש את כל תהליך החיבור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の流れ全体をやり直すことなく、有効な位置情報セッションを新しく選んだ場所へ移動できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需重新执行整个连接流程，即可将进行中的定位会话移动到新选择的地点。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve una sesión de ubicación activa a un lugar recién seleccionado sin reiniciar todo el proceso de conexión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需重新執行整個連線流程，即可將進行中的定位工作階段移動到新選擇的地點。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển phiên vị trí đang hoạt động đến địa điểm mới chọn mà không phải khởi động lại toàn bộ quy trình kết nối."
          }
        }
      }
    },
