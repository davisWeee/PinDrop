    "Keep the active session and return to the map so you can choose another destination.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالجلسة النشطة وعد إلى الخريطة لتختار وجهة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez la session active et revenez à la carte pour choisir une autre destination."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie die aktive Sitzung bei und kehren Sie zur Karte zurück, um ein anderes Ziel zu wählen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור על הסשן הפעיל וחזור למפה כדי לבחור יעד אחר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なセッションを維持したまま地図に戻り、別の目的地を選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持当前会话并返回地图，以便选择其他目的地。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la sesión activa y vuelve al mapa para elegir otro destino."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持目前的工作階段並返回地圖，以便選擇其他目的地。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ phiên đang hoạt động và quay lại bản đồ để chọn điểm đến khác."
          }
        }
      }
    },
