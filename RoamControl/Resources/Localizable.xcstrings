    "Shows whether PinDrop is ready, connecting or active. Tap it for pairing and connection details.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض ما إذا كان PinDrop جاهزًا أو يتصل أو نشطًا. اضغط عليه لعرض تفاصيل الإقران والاتصال."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique si PinDrop est prêt, en cours de connexion ou actif. Touchez-le pour les détails de l’association et de la connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, ob PinDrop bereit ist, verbindet oder aktiv ist. Tippen Sie darauf für Details zu Kopplung und Verbindung."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג אם PinDrop מוכן, מתחבר או פעיל. הקש עליו לפרטי הצימוד והחיבור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropが準備完了・接続中・有効のどれかを表示します。タップするとペアリングと接続の詳細が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 PinDrop 是否就绪、正在连接或处于活动状态。点按可查看配对和连接详情。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra si PinDrop está listo, conectando o activo. Tócalo para ver los detalles de emparejamiento y conexión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 PinDrop 是否就緒、正在連線或處於作用中。點一下可查看配對和連線詳細資料。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho biết PinDrop đang sẵn sàng, đang kết nối hay đang hoạt động. Chạm vào để xem chi tiết ghép đôi và kết nối."
          }
        }
      }
    },
