    "Looking for a securely stored pairing record.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ البحث عن سجل إقران مخزَّن بأمان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche d’un enregistrement d’association stocké en toute sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nach einem sicher gespeicherten Kopplungsdatensatz gesucht."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחפש רשומת צימוד שמורה בצורה מאובטחת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に保存されたペアリング情報を探しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找安全存储的配对记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando un registro de emparejamiento almacenado de forma segura."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在尋找安全儲存的配對記錄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tìm bản ghi ghép đôi được lưu an toàn."
          }
        }
      }
    },
    "Make sure LocalDevVPN is connected, switch mobile data off briefly, then return to PinDrop.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من اتصال LocalDevVPN، وأوقف بيانات الجوال لوقت قصير، ثم عد إلى PinDrop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que LocalDevVPN est connecté, désactivez brièvement les données mobiles, puis revenez dans PinDrop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass LocalDevVPN verbunden ist, schalten Sie mobile Daten kurz aus und kehren Sie dann zu PinDrop zurück."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ודא ש‑LocalDevVPN מחובר, כבה את הנתונים הסלולריים לרגע וחזור אל PinDrop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPNが接続されていることを確認し、モバイルデータを一時的にオフにしてからPinDropに戻ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认 LocalDevVPN 已连接，暂时关闭移动数据，然后返回 PinDrop。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que LocalDevVPN esté conectado, desactiva los datos móviles un momento y vuelve a PinDrop."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認 LocalDevVPN 已連線，暫時關閉行動數據，然後回到 PinDrop。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đảm bảo LocalDevVPN đã kết nối, tắt dữ liệu di động trong giây lát rồi quay lại PinDrop."
          }
        }
      }
    },
