    "Save the selected place for quick use later. Favourites can be renamed or removed from the saved-locations screen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ المكان المحدد لاستخدامه سريعًا لاحقًا. يمكن إعادة تسمية المفضلة أو إزالتها من شاشة المواقع المحفوظة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le lieu sélectionné pour le réutiliser rapidement. Les favoris peuvent être renommés ou supprimés depuis l’écran des lieux enregistrés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern Sie den ausgewählten Ort für später. Favoriten lassen sich im Bildschirm „Gesicherte Orte“ umbenennen oder entfernen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור את המקום שנבחר לשימוש מהיר בהמשך. אפשר לשנות שם או להסיר מועדפים ממסך המקומות השמורים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した場所を保存して、後ですぐ使えます。お気に入りは保存した場所の画面で名前の変更や削除ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存所选地点以便日后快速使用。可在“已存地点”屏幕中重命名或移除收藏。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el lugar seleccionado para usarlo rápidamente más tarde. Los favoritos se pueden renombrar o quitar desde la pantalla de lugares guardados."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存所選地點以便日後快速使用。可在「已存地點」畫面中重新命名或移除收藏。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu địa điểm đã chọn để dùng nhanh sau này. Có thể đổi tên hoặc xóa mục yêu thích trong màn hình địa điểm đã lưu."
          }
        }
      }
    },
