    "Search above or tap anywhere on the map.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث بالأعلى أو انقر على أي مكان في الخريطة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez ci‑dessus ou touchez n’importe où sur la carte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben suchen oder irgendwo auf die Karte tippen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חפש למעלה או הקש בכל מקום במפה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で検索するか、地図上の任意の場所をタップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方搜索，或点按地图上的任意位置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca arriba o toca en cualquier punto del mapa."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方搜尋，或點一下地圖上的任何位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm ở trên hoặc chạm vào bất kỳ đâu trên bản đồ."
          }
        }
      }
    },
    "Search for a destination or tap the map, then save it as your target.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن وجهة أو انقر على الخريطة، ثم احفظها كهدفك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez une destination ou touchez la carte, puis enregistrez-la comme cible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie ein Ziel oder tippen Sie auf die Karte und sichern Sie es als Ihr Ziel."
