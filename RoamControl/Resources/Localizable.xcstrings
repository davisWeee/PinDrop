    "Ask Apple Maps for a walking route from your current point to the selected destination before anything starts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من خرائط Apple مسار مشي من نقطتك الحالية إلى الوجهة المحددة قبل أن يبدأ أي شيء."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à Plans un itinéraire à pied de votre position actuelle à la destination choisie avant tout démarrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordern Sie in Apple Karten eine Gehroute von Ihrem aktuellen Punkt zum gewählten Ziel an, bevor etwas startet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקש מ‑Apple Maps מסלול הליכה מהנקודה הנוכחית שלך אל היעד שנבחר לפני שמשהו מתחיל."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かを開始する前に、現在地から選択した目的地までのウォーキングルートをApple マップに問い合わせます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在开始任何操作之前，向“地图”请求从当前位置到所选目的地的步行路线。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a Apple Maps una ruta a pie desde tu punto actual hasta el destino seleccionado antes de que empiece nada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在開始任何操作之前，向「地圖」要求從目前位置到所選目的地的步行路線。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu Apple Maps tuyến đi bộ từ điểm hiện tại đến điểm đến đã chọn trước khi bắt đầu."
          }
        }
      }
    },
