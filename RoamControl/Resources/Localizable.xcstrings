    "Create the pairing securely on this iPhone, or import an existing file.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ الإقران بأمان على هذا الـ iPhone، أو استورد ملفًا موجودًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez l’association en toute sécurité sur cet iPhone, ou importez un fichier existant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie die Kopplung sicher auf diesem iPhone oder importieren Sie eine vorhandene Datei."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צור את הצימוד בצורה מאובטחת ב‑iPhone הזה, או ייבא קובץ קיים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneで安全にペアリングを作成するか、既存のファイルを読み込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 iPhone 上安全创建配对，或导入现有文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el emparejamiento de forma segura en este iPhone o importa un archivo existente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這部 iPhone 上安全建立配對，或匯入現有檔案。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo ghép đôi an toàn trên iPhone này, hoặc nhập tệp có sẵn."
          }
        }
      }
    },
