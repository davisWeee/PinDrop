        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングに時間がかかりすぎました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对耗时过长，请重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El emparejamiento tardó demasiado. Inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對耗時過長，請再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép đôi mất quá nhiều thời gian. Vui lòng thử lại."
          }
        }
      }
    },
    "Pairing took too long. Return to PinDrop and try again.": {
