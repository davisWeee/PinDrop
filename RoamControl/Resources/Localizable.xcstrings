    "Pair this iPhone once so PinDrop can identify it through LocalDevVPN.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرن هذا الـ iPhone مرة واحدة ليتمكن PinDrop من التعرف عليه عبر LocalDevVPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez cet iPhone une fois pour que PinDrop puisse l’identifier via LocalDevVPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie dieses iPhone einmal, damit PinDrop es über LocalDevVPN erkennen kann."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צמד את ה‑iPhone הזה פעם אחת כדי ש‑PinDrop יוכל לזהות אותו דרך LocalDevVPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneを一度ペアリングすると、PinDropがLocalDevVPN経由で識別できるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需配对这台 iPhone 一次，PinDrop 即可通过 LocalDevVPN 识别它。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja este iPhone una vez para que PinDrop pueda identificarlo mediante LocalDevVPN."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只需配對這部 iPhone 一次，PinDrop 即可透過 LocalDevVPN 識別它。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép đôi iPhone này một lần để PinDrop nhận diện qua LocalDevVPN."
          }
        }
      }
    },
