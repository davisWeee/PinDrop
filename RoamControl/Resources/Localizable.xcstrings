    "Keep Developer Mode enabled on the iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ وضع المطور مفعّلًا على الـ iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le mode développeur activé sur l’iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie den Entwicklermodus auf dem iPhone aktiviert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר את מצב המפתח מופעל ב‑iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのデベロッパモードを有効にしたままにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 iPhone 上的开发者模式处于开启状态。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén activado el modo desarrollador en el iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持 iPhone 上的開發者模式為開啟狀態。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ Chế độ nhà phát triển luôn bật trên iPhone."
          }
        }
      }
    },
    "Keep PinDrop running. You can use other apps while the walk continues.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ PinDrop قيد التشغيل. يمكنك استخدام تطبيقات أخرى أثناء استمرار المشي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez PinDrop actif. Vous pouvez utiliser d’autres apps pendant la marche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie PinDrop laufen. Sie können andere Apps nutzen, während das Gehen weiterläuft."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר את PinDrop פועל. אפשר להשתמש באפליקציות אחרות בזמן שההליכה נמשכת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropを実行したままにしてください。ウォーキング中は他のアプリを使えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 PinDrop 运行。步行进行期间您可以使用其他 App。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén PinDrop en ejecución. Puedes usar otras apps mientras continúa la caminata."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持 PinDrop 執行。步行進行期間您可以使用其他 App。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy để PinDrop tiếp tục chạy. Bạn có thể dùng ứng dụng khác trong khi đi bộ."
          }
        }
      }
    },
    "Keep Walking": {
      "extractionState": "manual",
      "localizations": {
