        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’arrivée, inversez le trajet et revenez par le même itinéraire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Ankunft können Sie die Strecke umkehren und die Route zurückgehen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאחר ההגעה, הפוך את המסע וחזור ברגל לאורך המסלול."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "到着後、行程を逆にしてルートを引き返せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达后，可反向行进，沿原路线返回。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras llegar, invierte el recorrido y vuelve caminando por la misma ruta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抵達後，可反向行進，沿原路線返回。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau khi đến nơi, đảo ngược hành trình và đi bộ trở lại dọc tuyến đường."
          }
        }
      }
    },
    "Allow Location access in Settings to show your real position.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الموقع في الإعدادات لإظهار موقعك الحقيقي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’accès à la localisation dans Réglages pour afficher votre position réelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie in den Einstellungen den Standortzugriff, um Ihre echte Position anzuzeigen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר גישה למיקום בהגדרות כדי להציג את המיקום האמיתי שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の位置を表示するには、設定で位置情報へのアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许访问位置信息，以显示您的真实位置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la ubicación en Ajustes para mostrar tu posición real."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「設定」中允許取用位置，以顯示您的真實位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho phép truy cập Vị trí trong Cài đặt để hiển thị vị trí thật của bạn."
          }
        }
      }
    },
