    "Tap the heart on any selected place to save it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على القلب في أي مكان محدد لحفظه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cœur sur un lieu sélectionné pour l’enregistrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie bei einem ausgewählten Ort auf das Herz, um ihn zu speichern."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על הלב בכל מקום שנבחר כדי לשמור אותו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した場所のハートをタップすると保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所选地点上点按心形图标即可收藏。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el corazón en cualquier lugar seleccionado para guardarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在所選地點上點一下心形圖示即可收藏。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào trái tim ở bất kỳ địa điểm nào đã chọn để lưu."
          }
        }
      }
    },
    "Tap the map": {
