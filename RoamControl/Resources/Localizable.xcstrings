    "The pairing engine returned an empty record.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد محرك الإقران سجلًا فارغًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur d’association a renvoyé un enregistrement vide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopplungs-Engine hat einen leeren Datensatz zurückgegeben."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מנוע הצימוד החזיר רשומה ריקה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングエンジンが空の情報を返しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对引擎返回了空记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de emparejamiento devolvió un registro vacío."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對引擎傳回了空白記錄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ ghép đôi trả về bản ghi trống."
          }
        }
      }
    },
    "The pairing file's public and private keys do not match.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح العام والخاص في ملف الإقران غير متطابقين."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés publique et privée du fichier d’association ne correspondent pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentlicher und privater Schlüssel der Kopplungsdatei passen nicht zusammen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח הציבורי והפרטי בקובץ הצימוד אינם תואמים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリングファイルの公開鍵と秘密鍵が一致しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对文件中的公钥和私钥不匹配。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves pública y privada del archivo de emparejamiento no coinciden."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對檔案中的公開金鑰與私密金鑰不相符。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa công khai và khóa riêng của tệp ghép đôi không khớp."
          }
        }
      }
    },
    "The pairing record is generated or checked on this iPhone, then stored only in its Keychain. PinDrop does not upload it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إنشاء سجل الإقران أو فحصه على هذا الـ iPhone ثم يُخزَّن في سلسلة المفاتيح فقط. لا يرفعه PinDrop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement d’association est généré ou vérifié sur cet iPhone, puis stocké uniquement dans son trousseau. PinDrop ne l’envoie pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kopplungsdatensatz wird auf diesem iPhone erzeugt oder geprüft und nur in dessen Schlüsselbund gespeichert. PinDrop lädt ihn nicht hoch."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשומת הצימוד נוצרת או נבדקת ב‑iPhone הזה ומאוחסנת רק ב‑Keychain שלו. PinDrop אינו מעלה אותה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング情報はこのiPhone上で生成または確認され、キーチェーンにのみ保存されます。PinDropがアップロードすることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对记录在这台 iPhone 上生成或检查，并且仅存储在其钥匙串中。PinDrop 不会上传它。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de emparejamiento se genera o comprueba en este iPhone y se guarda solo en su llavero. PinDrop no lo sube."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配對記錄在這部 iPhone 上產生或檢查，並且僅儲存在其鑰匙圈中。PinDrop 不會上傳它。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi ghép đôi được tạo hoặc kiểm tra trên iPhone này, rồi chỉ lưu trong Chuỗi khóa của máy. PinDrop không tải nó lên."
          }
        }
      }
    },
    "The pairing record is valid and this iPhone is reachable through LocalDevVPN.": {
      "extractionState": "manual",
      "localizations": {
