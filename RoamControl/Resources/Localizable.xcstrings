            "value": "Auf die Karte tippen"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על המפה"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図をタップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按地图"
          }
        },
        "es": {
          "stringUnit": {
