    },
    "Begin moving the reported location along the previewed route. The walk can continue while you use another app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بتحريك الموقع المُبلَّغ عنه على طول المسار المعاين. يمكن أن يستمر المشي أثناء استخدامك تطبيقًا آخر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à déplacer la position signalée le long de l’itinéraire prévisualisé. La marche peut continuer pendant que vous utilisez une autre app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie, den gemeldeten Standort entlang der Vorschau-Route zu bewegen. Das Gehen läuft weiter, während Sie eine andere App verwenden."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל להזיז את המיקום המדווח לאורך המסלול שנצפה. ההליכה יכולה להימשך בזמן שאתה משתמש באפליקציה אחרת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューしたルートに沿って、報告される位置の移動を開始します。他のアプリを使っている間もウォーキングは続きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始沿预览的路线移动上报的位置。您使用其他 App 时，步行仍会继续。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a mover la ubicación informada por la ruta previsualizada. La caminata puede continuar mientras usas otra app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始沿預覽的路線移動回報的位置。您使用其他 App 時，步行仍會繼續。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu di chuyển vị trí được báo dọc theo tuyến đã xem trước. Việc đi bộ có thể tiếp tục khi bạn dùng ứng dụng khác."
          }
        }
      }
    },
