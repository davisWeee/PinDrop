    "View onboarding again without deleting your pairing, favourites, history or preferences.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض شاشات البدء مرة أخرى دون حذف الإقران أو المفضلة أو السجل أو التفضيلات."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoyez la présentation sans supprimer votre association, vos favoris, votre historique ni vos préférences."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie die Einführung erneut, ohne Kopplung, Favoriten, Verlauf oder Einstellungen zu löschen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צפה שוב בהקדמה בלי למחוק את הצימוד, המועדפים, ההיסטוריה או ההעדפות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング、お気に入り、履歴、設定を削除せずに、もう一度紹介画面を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次查看引导页，不会删除配对、收藏、历史记录或偏好设置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ver la introducción sin borrar tu emparejamiento, favoritos, historial ni preferencias."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次檢視引導頁，不會刪除配對、收藏、記錄或偏好設定。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại phần giới thiệu mà không xóa ghép đôi, mục yêu thích, lịch sử hay tùy chọn."
          }
        }
      }
    },
