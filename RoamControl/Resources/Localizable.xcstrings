      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ المشي"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer la marche"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen starten"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל ללכת"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォーキングを開始"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始步行"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar a caminar"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始步行"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu đi bộ"
          }
        }
      }
    },
    "Start a fixed location or preview a walking route.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ موقعًا ثابتًا أو عاين مسار مشي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez une position fixe ou prévisualisez un itinéraire à pied."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie einen festen Standort oder sehen Sie eine Gehroute in der Vorschau an."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל מיקום קבוע או הצג תצוגה מקדימה של מסלול הליכה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定の位置を開始するか、ウォーキングルートをプレビューします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始固定位置，或预览步行路线。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una ubicación fija o previsualiza una ruta a pie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始固定位置，或預覽步行路線。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu một vị trí cố định hoặc xem trước tuyến đi bộ."
          }
        }
      }
    },
    "Start reporting the selected place as this iPhone’s location. LocalDevVPN must be connected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ الإبلاغ عن المكان المحدد على أنه موقع هذا الـ iPhone. يجب أن يكون LocalDevVPN متصلًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à signaler le lieu sélectionné comme position de cet iPhone. LocalDevVPN doit être connecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie den ausgewählten Ort als Standort dieses iPhone. LocalDevVPN muss verbunden sein."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל לדווח על המקום שנבחר כמיקום של ה‑iPhone הזה. LocalDevVPN חייב להיות מחובר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した場所をこのiPhoneの位置として報告し始めます。LocalDevVPNが接続されている必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始将所选地点作为这台 iPhone 的位置上报。LocalDevVPN 必须处于连接状态。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a informar del lugar seleccionado como la ubicación de este iPhone. LocalDevVPN debe estar conectado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始將所選地點作為這部 iPhone 的位置回報。LocalDevVPN 必須處於連線狀態。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu báo địa điểm đã chọn là vị trí của iPhone này. LocalDevVPN phải được kết nối."
          }
        }
      }
    },
    "Start when ready. Stop restores this iPhone's real location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ عندما تكون جاهزًا. يعيد الإيقاف الموقع الحقيقي لهذا الـ iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez quand vous êtes prêt. L’arrêt rétablit la position réelle de cet iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie, wenn Sie bereit sind. Beim Beenden wird der echte Standort dieses iPhone wiederhergestellt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל כשתהיה מוכן. העצירה משחזרת את המיקום האמיתי של ה‑iPhone הזה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備ができたら開始してください。停止すると、このiPhoneの実際の位置情報に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好后即可开始。停止后会恢复这台 iPhone 的真实位置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia cuando estés listo. Al detener, se restaura la ubicación real de este iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備好後即可開始。停止後會恢復這部 iPhone 的真實位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu khi bạn sẵn sàng. Dừng sẽ khôi phục vị trí thật của iPhone này."
          }
        }
      }
    },
