          "stringUnit": {
            "state": "translated",
            "value": "Chọn điểm bắt đầu trên bản đồ."
          }
        }
      }
    },
    "Choose how quickly the simulated location moves along the route.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدى سرعة تحرك الموقع المحاكى على طول المسار."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la vitesse à laquelle la position simulée avance sur l’itinéraire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie, wie schnell sich der simulierte Standort entlang der Route bewegt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר באיזו מהירות המיקום המדומה נע לאורך המסלול."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレートした位置がルート上をどのくらいの速さで進むかを選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择模拟位置沿路线移动的速度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige a qué velocidad se mueve la ubicación simulada por la ruta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇模擬位置沿路線移動的速度。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tốc độ vị trí giả lập di chuyển dọc tuyến đường."
          }
        }
      }
    },
    "Choose where to send or save the report using the iOS share sheet. It never includes pairing keys or PINs.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مكان إرسال التقرير أو حفظه باستخدام ورقة المشاركة في iOS. لا يتضمن أبدًا مفاتيح الإقران أو أرقام PIN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où envoyer ou enregistrer le rapport via la feuille de partage iOS. Il n’inclut jamais de clés d’association ni de codes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie über das iOS-Teilen-Menü, wohin der Bericht gesendet oder gesichert wird. Er enthält nie Kopplungsschlüssel oder PINs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר לאן לשלוח או לשמור את הדוח באמצעות גיליון השיתוף של iOS. הוא לעולם אינו כולל מפתחות צימוד או קודי PIN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの共有シートで、レポートの送信先または保存先を選びます。ペアリングキーやPINは含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 iOS 共享面板选择发送或保存报告的位置。报告绝不包含配对密钥或 PIN。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde enviar o guardar el informe con la hoja de compartir de iOS. Nunca incluye claves de emparejamiento ni PIN."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 iOS 分享面板選擇傳送或儲存報告的位置。報告絕不包含配對金鑰或 PIN。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nơi gửi hoặc lưu báo cáo bằng bảng chia sẻ của iOS. Báo cáo không bao giờ chứa khóa ghép đôi hay mã PIN."
          }
        }
      }
    },
    "Choose where your iPhone should appear, from one simple map.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر المكان الذي يجب أن يظهر فيه iPhone من خلال خريطة واحدة بسيطة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où votre iPhone doit apparaître, depuis une seule carte simple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie auf einer einfachen Karte, wo Ihr iPhone erscheinen soll."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר היכן ה‑iPhone שלך יופיע, ממפה אחת פשוטה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンプルな1枚の地図から、iPhoneを表示する場所を選べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一张简洁的地图上，选择您的 iPhone 显示的位置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige dónde debe aparecer tu iPhone desde un único mapa sencillo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一張簡潔的地圖上，選擇您的 iPhone 顯示的位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nơi iPhone của bạn xuất hiện, từ một bản đồ đơn giản."
          }
        }
      }
    },
    "Choose whether to help improve PinDrop with anonymous activity counts. Sharing starts only if you switch it on and can be changed later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كنت تريد المساعدة في تحسين PinDrop عبر أعداد نشاط مجهولة. لا تبدأ المشاركة إلا إذا شغّلتها، ويمكن تغييرها لاحقًا في الإعدادات."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si vous souhaitez aider à améliorer PinDrop grâce à des compteurs d’activité anonymes. Le partage ne démarre que si vous l’activez et peut être modifié plus tard dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entscheiden Sie, ob Sie PinDrop mit anonymen Aktivitätszählungen verbessern helfen. Das Teilen beginnt nur, wenn Sie es einschalten, und lässt sich später in den Einstellungen ändern."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר אם לעזור בשיפור PinDrop באמצעות ספירות פעילות אנונימיות. השיתוף מתחיל רק אם תפעיל אותו, וניתן לשנות זאת מאוחר יותר בהגדרות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名のアクティビティ数でPinDropの改善に協力するかどうかを選べます。共有はオンにした場合にのみ開始され、後で設定から変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择是否通过匿名活动计数帮助改进 PinDrop。仅在您开启后才会开始共享，之后可随时在“设置”中更改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres ayudar a mejorar PinDrop con recuentos de actividad anónimos. Solo se comparte si lo activas y puedes cambiarlo más tarde en Ajustes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇是否透過匿名活動計數協助改進 PinDrop。僅在您開啟後才會開始分享，之後可隨時在「設定」中更改。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn có giúp cải thiện PinDrop bằng số liệu hoạt động ẩn danh hay không. Việc chia sẻ chỉ bắt đầu khi bạn bật và có thể thay đổi sau trong Cài đặt."
          }
        }
      }
    },
    "Choose, test and move this iPhone’s reported location from one clean map.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر موقع هذا الـ iPhone المُبلَّغ عنه واختبره وحرّكه من خريطة واحدة نظيفة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez, testez et déplacez la position signalée de cet iPhone depuis une seule carte claire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen, testen und bewegen Sie den gemeldeten Standort dieses iPhone auf einer übersichtlichen Karte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר, בדוק והזז את המיקום המדווח של ה‑iPhone הזה ממפה נקייה אחת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつのすっきりした地図で、このiPhoneの報告位置を選び、テストし、動かせます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一张简洁的地图上选择、测试并移动这台 iPhone 上报的位置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige, prueba y mueve la ubicación informada de este iPhone desde un único mapa limpio."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一張簡潔的地圖上選擇、測試並移動這部 iPhone 回報的位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn, thử và di chuyển vị trí được báo của iPhone này từ một bản đồ gọn gàng."
          }
        }
