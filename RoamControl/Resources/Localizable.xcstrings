    "Open saved favourites and recently used locations. Swipe an item to remove it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح المفضلة المحفوظة والمواقع المستخدمة مؤخرًا. اسحب عنصرًا لإزالته."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez vos favoris et vos positions récentes. Balayez un élément pour le supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie gesicherte Favoriten und zuletzt verwendete Standorte. Wischen Sie einen Eintrag, um ihn zu entfernen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח מועדפים שמורים ומיקומים שהיו בשימוש לאחרונה. החלק פריט כדי להסיר אותו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したお気に入りと最近使った場所を開きます。項目をスワイプすると削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开已收藏和最近使用的位置。滑动某一项即可移除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre tus favoritos guardados y las ubicaciones usadas recientemente. Desliza un elemento para quitarlo."
