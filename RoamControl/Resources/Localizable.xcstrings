    "Enter latitude from −90 to 90 and longitude from −180 to 180.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل خط العرض من ‎−90 إلى 90 وخط الطول من ‎−180 إلى 180."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une latitude de −90 à 90 et une longitude de −180 à 180."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Breitengrad von −90 bis 90 und einen Längengrad von −180 bis 180 ein."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן קו רוחב בין ‎−90 ל‑90 וקו אורך בין ‎−180 ל‑180."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緯度は−90〜90、経度は−180〜180の範囲で入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 −90 到 90 的纬度和 −180 到 180 的经度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una latitud de −90 a 90 y una longitud de −180 a 180."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 −90 到 90 的緯度和 −180 到 180 的經度。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập vĩ độ từ −90 đến 90 và kinh độ từ −180 đến 180."
          }
        }
      }
    },
    "Enter the six-digit code in Settings to confirm.": {
