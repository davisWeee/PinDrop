    "Hold the current point on the route, then continue from exactly where it paused.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ النقطة الحالية على المسار، ثم تابع من حيث توقفت بالضبط."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le point actuel sur l’itinéraire, puis reprenez exactement où vous vous étiez arrêté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie den aktuellen Punkt auf der Route und machen Sie genau dort weiter, wo Sie pausiert haben."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזק את הנקודה הנוכחית במסלול, ואז המשך בדיוק מהמקום שבו השהית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルート上の現在地点で止め、一時停止した場所からそのまま再開できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停留在路线上的当前位置，之后从暂停处精确继续。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén el punto actual en la ruta y continúa exactamente desde donde se pausó."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停留在路線上的目前位置，之後從暫停處精確繼續。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nguyên điểm hiện tại trên tuyến, rồi tiếp tục đúng từ chỗ đã tạm dừng."
          }
        }
      }
    },
