    "Use the code shown here when iOS asks for it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الرمز الظاهر هنا عندما يطلبه iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
