            "value": "LocalDevVPN"
          }
        }
      }
    },
    "LocalDevVPN is visible, but its device announcement does not match the paired iPhone. Toggle LocalDevVPN off and on, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN ظاهر، لكن إعلان جهازه لا يطابق الـ iPhone المقترن. أوقف LocalDevVPN ثم شغّله وحاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN est visible, mais son annonce d’appareil ne correspond pas à l’iPhone associé. Désactivez puis réactivez LocalDevVPN, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN ist sichtbar, aber seine Geräteankündigung passt nicht zum gekoppelten iPhone. Schalten Sie LocalDevVPN aus und wieder ein und versuchen Sie es erneut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN גלוי, אך הכרזת המכשיר שלו אינה תואמת ל‑iPhone המצומד. כבה והפעל מחדש את LocalDevVPN ונסה שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPNは見えていますが、そのデバイス通知がペアリング済みのiPhoneと一致しません。LocalDevVPNをオフにしてからオンにして、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以看到 LocalDevVPN，但其设备通告与已配对的 iPhone 不匹配。请关闭再打开 LocalDevVPN，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPN es visible, pero su anuncio de dispositivo no coincide con el iPhone emparejado. Desactiva y vuelve a activar LocalDevVPN e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以看到 LocalDevVPN，但其裝置通告與已配對的 iPhone 不相符。請關閉再開啟 LocalDevVPN，然後再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thấy LocalDevVPN, nhưng thông báo thiết bị của nó không khớp với iPhone đã ghép đôi. Hãy tắt rồi bật lại LocalDevVPN, sau đó thử lại."
          }
        }
      }
    },
    "LocalDevVPN reachability can only be checked on a physical iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن فحص إمكانية الوصول إلى LocalDevVPN إلا على iPhone فعلي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accessibilité de LocalDevVPN ne peut être vérifiée que sur un iPhone physique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erreichbarkeit von LocalDevVPN lässt sich nur auf einem physischen iPhone prüfen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן לבדוק את נגישות LocalDevVPN רק ב‑iPhone פיזי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPNへの到達性は、実機のiPhoneでのみ確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能在实体 iPhone 上检查 LocalDevVPN 的可达性。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La accesibilidad de LocalDevVPN solo se puede comprobar en un iPhone físico."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能在實體 iPhone 上檢查 LocalDevVPN 的可連線性。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể kiểm tra khả năng truy cập LocalDevVPN trên iPhone thật."
          }
        }
      }
    },
