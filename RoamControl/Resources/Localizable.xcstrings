    "Restoring reconnects only long enough to clear the simulated location. Nothing starts automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد الاستعادة الاتصال لمدة كافية فقط لمسح الموقع المحاكى. لا يبدأ شيء تلقائيًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration ne se reconnecte que le temps d’effacer la position simulée. Rien ne démarre automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Wiederherstellen wird nur so lange verbunden, bis der simulierte Standort gelöscht ist. Nichts startet automatisch."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השחזור מתחבר מחדש רק לזמן הדרוש כדי לנקות את המיקום המדומה. דבר לא מתחיל אוטומטית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元では、シミュレートした位置情報を消去するのに必要な間だけ再接続します。自動で開始されるものはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复只会重新连接足够长的时间来清除模拟位置，不会自动开始任何操作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración solo se reconecta el tiempo necesario para borrar la ubicación simulada. No se inicia nada automáticamente."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復只會重新連線足夠長的時間來清除模擬位置，不會自動開始任何操作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc khôi phục chỉ kết nối lại đủ lâu để xóa vị trí giả lập. Không có gì tự động bắt đầu."
          }
        }
      }
    },
