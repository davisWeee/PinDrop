    "Erase the pairing record and all saved app choices, then return to onboarding. LocalDevVPN itself is not changed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح سجل الإقران وجميع خيارات التطبيق المحفوظة، ثم عد إلى شاشات البدء. لا يتغير LocalDevVPN نفسه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacez l’association et tous les choix enregistrés, puis revenez à la présentation. LocalDevVPN n’est pas modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den Kopplungsdatensatz und alle gesicherten App-Einstellungen und kehrt zur Einführung zurück. LocalDevVPN selbst bleibt unverändert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחק את רשומת הצימוד ואת כל בחירות האפליקציה השמורות, ואז חזור להקדמה. LocalDevVPN עצמו אינו משתנה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング情報と保存したすべてのアプリ設定を消去し、紹介画面に戻ります。LocalDevVPN自体は変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除配对记录和所有已保存的 App 选项，然后返回引导页。LocalDevVPN 本身不会改变。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el registro de emparejamiento y todas las opciones guardadas de la app y vuelve a la introducción. LocalDevVPN no se modifica."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除配對記錄和所有已儲存的 App 選項，然後返回引導頁。LocalDevVPN 本身不會改變。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa bản ghi ghép đôi và mọi lựa chọn đã lưu của ứng dụng, rồi quay lại phần giới thiệu. Bản thân LocalDevVPN không bị thay đổi."
          }
        }
      }
    },
    "Every favourite will be removed. Your history will be kept.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة كل المفضلة. سيتم الاحتفاظ بسجلك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les favoris seront supprimés. Votre historique sera conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Favoriten werden entfernt. Ihr Verlauf bleibt erhalten."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל המועדפים יוסרו. ההיסטוריה שלך תישמר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのお気に入りが削除されます。履歴は保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有收藏都将被移除，历史记录将保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los favoritos. Tu historial se conservará."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有收藏都將被移除，記錄將保留。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả mục yêu thích sẽ bị xóa. Lịch sử của bạn sẽ được giữ lại."
          }
        }
      }
    },
    "Every recently used location will be removed. Your favourites will be kept.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة كل المواقع المستخدمة مؤخرًا. سيتم الاحتفاظ بمفضلتك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les positions récentes seront supprimées. Vos favoris seront conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle zuletzt verwendeten Standorte werden entfernt. Ihre Favoriten bleiben erhalten."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל המיקומים שהיו בשימוש לאחרונה יוסרו. המועדפים שלך יישמרו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使用したすべての場所が削除されます。お気に入りは保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有最近使用的位置都将被移除，收藏将保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todas las ubicaciones usadas recientemente. Tus favoritos se conservarán."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有最近使用的位置都將被移除，收藏將保留。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả vị trí đã dùng gần đây sẽ bị xóa. Mục yêu thích của bạn sẽ được giữ lại."
          }
        }
      }
    },
