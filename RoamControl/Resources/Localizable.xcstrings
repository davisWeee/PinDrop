          }
        }
      }
    },
    "Stop walking, clear the route and restore the real location. A confirmation helps prevent accidental stops.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف المشي وامسح المسار واستعد الموقع الحقيقي. يساعد التأكيد على منع الإيقاف غير المقصود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez la marche, effacez l’itinéraire et rétablissez la position réelle. Une confirmation évite les arrêts accidentels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie das Gehen, löschen Sie die Route und stellen Sie den echten Standort wieder her. Eine Bestätigung verhindert versehentliches Beenden."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עצור את ההליכה, נקה את המסלול ושחזר את המיקום האמיתי. אישור עוזר למנוע עצירות מקריות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォーキングを停止し、ルートを消去して実際の位置情報を復元します。誤って停止しないよう確認が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止步行、清除路线并恢复真实位置。确认提示可防止误操作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén la caminata, borra la ruta y restaura la ubicación real. Una confirmación ayuda a evitar paradas accidentales."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止步行、清除路線並恢復真實位置。確認提示可防止誤操作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng đi bộ, xóa tuyến và khôi phục vị trí thật. Hộp xác nhận giúp tránh dừng nhầm."
          }
        }
      }
    },
