          "stringUnit": {
            "state": "translated",
            "value": "无法使用步行"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminata no disponible"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用步行"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đi bộ"
          }
        }
      }
    },
    "Welcome to PinDrop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بك في PinDrop"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans PinDrop"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen bei PinDrop"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברוכים הבאים אל PinDrop"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropへようこそ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 PinDrop"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te damos la bienvenida a PinDrop"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎使用 PinDrop"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng đến với PinDrop"
          }
        }
      }
    },
    "What Is Shared": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي تتم مشاركته"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est partagé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was geteilt wird"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה משותף"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有される内容"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享的内容"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué se comparte"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享的內容"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì được chia sẻ"
          }
        }
      }
    },
    "When using mobile data, temporarily turn it off when asked. PinDrop continues automatically once the local connection is available, and tells you when data can go back on.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند استخدام بيانات الجوال، أوقفها مؤقتًا عند الطلب. يتابع PinDrop تلقائيًا بمجرد توفر الاتصال المحلي، ويخبرك عندما يمكن إعادة تشغيل البيانات."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec les données mobiles, désactivez-les temporairement lorsque c’est demandé. PinDrop continue automatiquement dès que la connexion locale est disponible et vous indique quand les réactiver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei mobilen Daten schalten Sie diese auf Aufforderung kurz aus. PinDrop macht automatisch weiter, sobald die lokale Verbindung steht, und sagt Ihnen, wann die Daten wieder an dürfen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בעת שימוש בנתונים סלולריים, כבה אותם זמנית כשמתבקש. PinDrop ממשיך אוטומטית כשהחיבור המקומי זמין ומודיע לך מתי אפשר להפעיל שוב את הנתונים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルデータをご利用の場合は、案内に従って一時的にオフにしてください。ローカル接続が使えるようになるとPinDropが自動的に続行し、データをオンに戻せるタイミングもお知らせします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用移动数据时，请在提示时暂时将其关闭。本地连接可用后，PinDrop 会自动继续，并告知您何时可以重新打开数据。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si usas datos móviles, desactívalos temporalmente cuando se te pida. PinDrop continúa automáticamente en cuanto la conexión local esté disponible y te avisa cuándo puedes volver a activar los datos."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用行動數據時，請在提示時暫時將其關閉。本機連線可用後，PinDrop 會自動繼續，並告知您何時可以重新開啟數據。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi dùng dữ liệu di động, hãy tạm tắt khi được yêu cầu. PinDrop tự động tiếp tục khi kết nối cục bộ sẵn sàng và báo cho bạn khi có thể bật lại dữ liệu."
          }
        }
      }
    },
    "Your location will move along this route at the selected pace.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتحرك موقعك على طول هذا المسار بالوتيرة المحددة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position se déplacera le long de cet itinéraire à l’allure choisie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Standort bewegt sich im gewählten Tempo entlang dieser Route."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקום שלך יתקדם לאורך המסלול הזה בקצב שנבחר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した速さで、このルートに沿って位置情報が移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的位置将按所选速度沿此路线移动。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación se moverá por esta ruta al ritmo seleccionado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的位置將依所選速度沿此路線移動。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí của bạn sẽ di chuyển dọc tuyến đường này với tốc độ đã chọn."
          }
        }
      }
    },
    "Your pairing record and local choices will be removed. You will return to the welcome screen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة سجل الإقران وخياراتك المحلية. ستعود إلى شاشة الترحيب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre association et vos choix locaux seront supprimés. Vous reviendrez à l’écran d’accueil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Kopplungsdatensatz und Ihre lokalen Einstellungen werden entfernt. Sie kehren zum Begrüßungsbildschirm zurück."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשומת הצימוד וההעדפות המקומיות שלך יוסרו. תחזור למסך הפתיחה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング情報とローカル設定が削除され、ようこそ画面に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的配对记录和本地选项将被移除，并返回欢迎界面。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitarán tu registro de emparejamiento y tus opciones locales. Volverás a la pantalla de bienvenida."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的配對記錄和本機選項將被移除，並返回歡迎畫面。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi ghép đôi và lựa chọn cục bộ của bạn sẽ bị xóa. Bạn sẽ quay lại màn hình chào mừng."
          }
        }
      }
    },
    "Your real location is not available yet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعك الحقيقي غير متاح بعد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position réelle n’est pas encore disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr echter Standort ist noch nicht verfügbar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקום האמיתי שלך עדיין אינו זמין."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の位置情報はまだ利用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法获取您的真实位置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación real aún no está disponible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法取得您的真實位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có vị trí thật của bạn."
          }
        }
      }
    },
    "Your route progress will be reset.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إعادة ضبط تقدم مسارك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression de votre itinéraire sera réinitialisée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Routenfortschritt wird zurückgesetzt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתקדמות במסלול תאופס."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートの進行状況はリセットされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的路线进度将被重置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecerá el progreso de tu ruta."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的路線進度將被重設。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiến trình tuyến đường của bạn sẽ được đặt lại."
          }
        }
      }
    },
    "Your spoofed location is being held here until you resume.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الإبقاء على موقعك المحاكى هنا حتى تستأنف."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position simulée est maintenue ici jusqu’à la reprise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr simulierter Standort wird hier gehalten, bis Sie fortfahren."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקום המדומה שלך נשמר כאן עד שתמשיך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再開するまで、シミュレートした位置情報はここで保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您继续之前，模拟位置将保持在此处。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación simulada se mantiene aquí hasta que reanudes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您繼續之前，模擬位置將保持在此處。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí giả lập của bạn được giữ tại đây cho đến khi bạn tiếp tục."
          }
        }
      }
    },
    "iOS could not keep pairing active in the background. Keep PinDrop open and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على iOS إبقاء الإقران نشطًا في الخلفية. أبقِ PinDrop مفتوحًا وحاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’a pas pu maintenir l’association active en arrière-plan. Gardez PinDrop ouvert et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS konnte die Kopplung nicht im Hintergrund aktiv halten. Lassen Sie PinDrop geöffnet und versuchen Sie es erneut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS לא הצליחה להשאיר את הצימוד פעיל ברקע. השאר את PinDrop פתוח ונסה שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがペアリングをバックグラウンドで維持できませんでした。PinDropを開いたままにして再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法在后台保持配对处于活动状态。请保持 PinDrop 打开并重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no pudo mantener el emparejamiento activo en segundo plano. Mantén PinDrop abierto e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 無法在背景保持配對處於作用中。請保持 PinDrop 開啟並再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không thể giữ ghép đôi hoạt động ở chế độ nền. Hãy để PinDrop mở và thử lại."
          }
        }
      }
    },
    "iOS could not prepare the location session. Close PinDrop, reopen it, and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على iOS تجهيز جلسة الموقع. أغلق PinDrop وأعد فتحه ثم حاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’a pas pu préparer la session de localisation. Fermez PinDrop, rouvrez-le, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS konnte die Standortsitzung nicht vorbereiten. Beenden Sie PinDrop, öffnen Sie es erneut und versuchen Sie es noch einmal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS לא הצליחה להכין את סשן המיקום. סגור את PinDrop, פתח אותו מחדש ונסה שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSが位置情報セッションを準備できませんでした。PinDropを閉じてもう一度開き、再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法准备定位会话。请关闭 PinDrop 并重新打开，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no pudo preparar la sesión de ubicación. Cierra PinDrop, vuelve a abrirlo e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 無法準備定位工作階段。請關閉 PinDrop 並重新打開，然後再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không thể chuẩn bị phiên vị trí. Hãy đóng PinDrop, mở lại rồi thử lại."
          }
        }
      }
    },
    "iOS could not register the secure pairing task. Close PinDrop, reopen it, and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على iOS تسجيل مهمة الإقران الآمنة. أغلق PinDrop وأعد فتحه ثم حاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n’a pas pu enregistrer la tâche d’association sécurisée. Fermez PinDrop, rouvrez-le, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS konnte die sichere Kopplungsaufgabe nicht registrieren. Beenden Sie PinDrop, öffnen Sie es erneut und versuchen Sie es noch einmal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS לא הצליחה לרשום את משימת הצימוד המאובטחת. סגור את PinDrop, פתח אותו מחדש ונסה שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSが安全なペアリングタスクを登録できませんでした。PinDropを閉じてもう一度開き、再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 无法注册安全配对任务。请关闭 PinDrop 并重新打开，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no pudo registrar la tarea de emparejamiento segura. Cierra PinDrop, vuelve a abrirlo e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 無法註冊安全配對工作。請關閉 PinDrop 並重新打開，然後再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS không thể đăng ký tác vụ ghép đôi bảo mật. Hãy đóng PinDrop, mở lại rồi thử lại."
          }
        }
      }
    }
  },
  "version": "1.0"
}
