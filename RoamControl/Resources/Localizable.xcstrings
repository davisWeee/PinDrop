    "Walking directions are unavailable. Check Location access and your internet connection, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتجاهات المشي غير متاحة. تحقق من إذن الوصول إلى الموقع واتصالك بالإنترنت ثم حاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les itinéraires à pied sont indisponibles. Vérifiez l’accès à la localisation et votre connexion Internet, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehrouten sind nicht verfügbar. Prüfen Sie den Standortzugriff und Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוראות הליכה אינן זמינות. בדוק את הגישה למיקום ואת חיבור האינטרנט ונסה שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォーキングの経路案内を利用できません。位置情報へのアクセスとインターネット接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取步行路线。请检查位置访问权限和网络连接，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las indicaciones a pie no están disponibles. Comprueba el acceso a la ubicación y tu conexión a internet y vuelve a intentarlo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得步行路線。請檢查位置取用權限和網路連線，然後再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có chỉ đường đi bộ. Hãy kiểm tra quyền truy cập Vị trí và kết nối internet rồi thử lại."
          }
        }
      }
    },
