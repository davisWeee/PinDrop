    "PinDrop can use this record when the LocalDevVPN session layer is connected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ PinDrop استخدام هذا السجل عندما تكون طبقة جلسة LocalDevVPN متصلة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop peut utiliser cet enregistrement lorsque la couche de session LocalDevVPN est connectée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop kann diesen Datensatz verwenden, sobald die LocalDevVPN-Sitzungsebene verbunden ist."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop יכול להשתמש ברשומה הזו כאשר שכבת הסשן של LocalDevVPN מחוברת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LocalDevVPNのセッション層が接続されると、PinDropはこの情報を使用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 LocalDevVPN 会话层连接后，PinDrop 即可使用此记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop puede usar este registro cuando la capa de sesión de LocalDevVPN esté conectada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 LocalDevVPN 工作階段層連線後，PinDrop 即可使用此記錄。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop có thể dùng bản ghi này khi lớp phiên của LocalDevVPN đã kết nối."
          }
        }
      }
    },
    "PinDrop could not find this iPhone through LocalDevVPN. Check that the tunnel is enabled and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على PinDrop العثور على هذا الـ iPhone عبر LocalDevVPN. تأكد من تفعيل النفق وحاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop n’a pas trouvé cet iPhone via LocalDevVPN. Vérifiez que le tunnel est activé et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop konnte dieses iPhone über LocalDevVPN nicht finden. Prüfen Sie, ob der Tunnel aktiviert ist, und versuchen Sie es erneut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop לא הצליח למצוא את ה‑iPhone הזה דרך LocalDevVPN. ודא שהמנהרה מופעלת ונסה שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropはLocalDevVPN経由でこのiPhoneを見つけられませんでした。トンネルが有効か確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 无法通过 LocalDevVPN 找到这台 iPhone。请确认隧道已启用，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop no pudo encontrar este iPhone a través de LocalDevVPN. Comprueba que el túnel esté activado e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 無法透過 LocalDevVPN 找到這部 iPhone。請確認通道已啟用，然後再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop không tìm thấy iPhone này qua LocalDevVPN. Hãy kiểm tra đường hầm đã bật và thử lại."
          }
        }
      }
    },
    "PinDrop could not follow this walking route.": {
