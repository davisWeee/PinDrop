    "Quickly select your most recent location again. Use its close button if you no longer want the suggestion.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر موقعك الأخير بسرعة مرة أخرى. استخدم زر الإغلاق إن لم تعد تريد الاقتراح."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Resélectionnez rapidement votre dernière position. Utilisez son bouton de fermeture si vous ne voulez plus de la suggestion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Ihren letzten Standort schnell erneut aus. Mit der Schließen-Taste blenden Sie den Vorschlag aus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר שוב במהירות את המיקום האחרון שלך. השתמש בלחצן הסגירה אם אינך רוצה עוד את ההצעה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の位置をすばやく選び直せます。提案が不要になったら閉じるボタンを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速重新选择您最近的位置。如果不再需要该建议，请使用其关闭按钮。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a seleccionar rápidamente tu ubicación más reciente. Usa su botón de cerrar si ya no quieres la sugerencia."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速重新選擇您最近的位置。若不再需要該建議，請使用其關閉按鈕。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn lại nhanh vị trí gần nhất của bạn. Dùng nút đóng nếu bạn không muốn gợi ý nữa."
          }
        }
      }
    },
