    "Appears when the map is rotated. It shows the map heading; tap it to face north again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر عند تدوير الخريطة. تعرض اتجاه الخريطة؛ اضغط عليها للعودة إلى الشمال."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparaît lorsque la carte est pivotée. Elle indique l’orientation de la carte ; touchez-la pour revenir au nord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheint, wenn die Karte gedreht wird. Sie zeigt die Kartenausrichtung; tippen Sie darauf, um wieder nach Norden zu zeigen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מופיע כשהמפה מסובבת. הוא מציג את כיוון המפה; הקש עליו כדי לפנות שוב צפונה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図を回転すると表示されます。地図の向きを示し、タップすると再び北向きになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转地图时会出现，显示地图方向；点按可再次朝向正北。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece cuando se gira el mapa. Muestra la orientación del mapa; tócala para volver a mirar al norte."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旋轉地圖時會出現，顯示地圖方向；點一下可再次朝向正北。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuất hiện khi bản đồ bị xoay. Nó hiển thị hướng bản đồ; chạm vào để quay về hướng bắc."
          }
        }
      }
    },
