    "Off by default. Never includes locations, searches, routes, pairing data or personal information.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف افتراضيًا. لا يتضمن أبدًا المواقع أو عمليات البحث أو المسارات أو بيانات الإقران أو المعلومات الشخصية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. N’inclut jamais de positions, recherches, itinéraires, données d’association ni informations personnelles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Enthält niemals Standorte, Suchanfragen, Routen, Kopplungsdaten oder persönliche Daten."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבוי כברירת מחדל. לעולם לא כולל מיקומים, חיפושים, מסלולים, נתוני צימוד או מידע אישי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定ではオフです。位置情報、検索、ルート、ペアリングデータ、個人情報は一切含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。绝不包含位置、搜索、路线、配对数据或个人信息。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado de forma predeterminada. Nunca incluye ubicaciones, búsquedas, rutas, datos de emparejamiento ni información personal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設為關閉。絕不包含位置、搜尋、路線、配對資料或個人資訊。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định tắt. Không bao giờ bao gồm vị trí, tìm kiếm, tuyến đường, dữ liệu ghép đôi hay thông tin cá nhân."
          }
        }
      }
    },
    "On-device pairing needs your physical iPhone.": {
