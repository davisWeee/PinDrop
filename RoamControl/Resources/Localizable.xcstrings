          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie die aktive Sitzung und stellen Sie den echten Standort dieses iPhone wieder her."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
