    "Still finding your real location. Tap the location button to try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال البحث عن موقعك الحقيقي جاريًا. اضغط على زر الموقع للمحاولة مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de votre position réelle en cours. Touchez le bouton de position pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr echter Standort wird noch ermittelt. Tippen Sie auf die Standorttaste, um es erneut zu versuchen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין מחפש את המיקום האמיתי שלך. הקש על לחצן המיקום כדי לנסות שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の位置情報をまだ取得中です。位置情報ボタンをタップして再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在查找您的真实位置。请点按定位按钮重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún se está buscando tu ubicación real. Toca el botón de ubicación para reintentar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在尋找您的真實位置。請點一下定位按鈕再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẫn đang tìm vị trí thật của bạn. Nhấn nút vị trí để thử lại."
          }
        }
      }
    },
