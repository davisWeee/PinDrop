    "Stop walking and restore your real location?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف المشي واستعادة موقعك الحقيقي؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la marche et restaurer votre position réelle ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehen beenden und echten Standort wiederherstellen?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
