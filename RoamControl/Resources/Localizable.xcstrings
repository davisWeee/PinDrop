      }
    },
    "PinDrop did not receive a normal end signal for the location at %@. Choose what this iPhone should do next.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتلقَّ PinDrop إشارة إنهاء عادية للموقع عند %@. اختر ما يجب أن يفعله هذا الـ iPhone بعد ذلك."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop n’a pas reçu de signal de fin normal pour la position à %@. Choisissez ce que cet iPhone doit faire ensuite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop hat für den Standort bei %@ kein normales Endsignal erhalten. Wählen Sie, was dieses iPhone als Nächstes tun soll."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop לא קיבל אות סיום רגיל עבור המיקום ב‑%@. בחר מה ה‑iPhone הזה צריך לעשות עכשיו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の位置情報について、PinDropは通常の終了信号を受信しませんでした。このiPhoneの次の動作を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 未收到位于 %@ 的位置的正常结束信号。请选择这台 iPhone 接下来的操作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop no recibió una señal de finalización normal para la ubicación en %@. Elige qué debe hacer este iPhone ahora."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 未收到位於 %@ 之位置的正常結束訊號。請選擇這部 iPhone 接下來的操作。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop không nhận được tín hiệu kết thúc bình thường cho vị trí tại %@. Hãy chọn việc iPhone này nên làm tiếp theo."
          }
        }
      }
    },
    "PinDrop did not receive a normal end signal while walking to %@. You can continue from the last saved point or safely restore your real location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتلقَّ PinDrop إشارة إنهاء عادية أثناء المشي إلى %@. يمكنك المتابعة من آخر نقطة محفوظة أو استعادة موقعك الحقيقي بأمان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop n’a pas reçu de signal de fin normal pendant la marche vers %@. Vous pouvez reprendre au dernier point enregistré ou restaurer votre position réelle en toute sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop hat beim Gehen nach %@ kein normales Endsignal erhalten. Sie können vom zuletzt gesicherten Punkt fortfahren oder Ihren echten Standort sicher wiederherstellen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop לא קיבל אות סיום רגיל בזמן ההליכה אל %@. אפשר להמשיך מהנקודה האחרונה ששמורה או לשחזר בבטחה את המיקום האמיתי שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@へのウォーキング中に、PinDropは通常の終了信号を受信しませんでした。最後に保存した地点から続行するか、実際の位置情報を安全に復元できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前往 %@ 的步行过程中，PinDrop 未收到正常的结束信号。您可以从最后保存的位置点继续，或安全地恢复真实位置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop no recibió una señal de finalización normal mientras caminaba hacia %@. Puedes continuar desde el último punto guardado o restaurar tu ubicación real de forma segura."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前往 %@ 的步行過程中，PinDrop 未收到正常的結束訊號。您可以從最後儲存的位置點繼續，或安全地恢復真實位置。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop không nhận được tín hiệu kết thúc bình thường khi đang đi bộ đến %@. Bạn có thể tiếp tục từ điểm đã lưu gần nhất hoặc khôi phục vị trí thật một cách an toàn."
          }
        }
      }
    },
    "PinDrop found an outdated device announcement. Toggle LocalDevVPN off and on, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عثر PinDrop على إعلان جهاز قديم. أوقف LocalDevVPN ثم شغّله وحاول مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop a trouvé une annonce d’appareil obsolète. Désactivez puis réactivez LocalDevVPN, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop hat eine veraltete Geräteankündigung gefunden. Schalten Sie LocalDevVPN aus und wieder ein und versuchen Sie es erneut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop מצא הכרזת מכשיר מיושנת. כבה והפעל מחדש את LocalDevVPN ונסה שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropが古いデバイス通知を見つけました。LocalDevVPNをオフにしてからオンにして、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 发现了过期的设备通告。请关闭再打开 LocalDevVPN，然后重试。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop encontró un anuncio de dispositivo obsoleto. Desactiva y vuelve a activar LocalDevVPN e inténtalo de nuevo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 發現了過期的裝置通告。請關閉再開啟 LocalDevVPN，然後再試一次。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop tìm thấy thông báo thiết bị đã cũ. Hãy tắt rồi bật lại LocalDevVPN, sau đó thử lại."
          }
        }
      }
    },
    "PinDrop has not found LocalDevVPN's device connection yet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعثر PinDrop على اتصال الجهاز عبر LocalDevVPN بعد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop n’a pas encore trouvé la connexion de l’appareil via LocalDevVPN."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop hat die Geräteverbindung von LocalDevVPN noch nicht gefunden."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop עדיין לא מצא את חיבור המכשיר של LocalDevVPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropはLocalDevVPNのデバイス接続をまだ見つけていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 尚未找到 LocalDevVPN 的设备连接。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop aún no ha encontrado la conexión del dispositivo de LocalDevVPN."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 尚未找到 LocalDevVPN 的裝置連線。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop chưa tìm thấy kết nối thiết bị của LocalDevVPN."
          }
        }
      }
    },
    "PinDrop is already changing the connection. Let it finish, then run the check again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم PinDrop بتغيير الاتصال بالفعل. دعه ينتهي ثم شغّل الفحص مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop modifie déjà la connexion. Laissez-le terminer, puis relancez la vérification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop ändert bereits die Verbindung. Warten Sie, bis es fertig ist, und starten Sie die Prüfung erneut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop כבר משנה את החיבור. תן לו לסיים ואז הפעל שוב את הבדיקה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropはすでに接続を変更中です。完了を待ってから、もう一度チェックを実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 正在更改连接。请等待其完成后再运行检查。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop ya está cambiando la conexión. Deja que termine y vuelve a ejecutar la comprobación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 正在更改連線。請等待其完成後再執行檢查。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop đang thay đổi kết nối. Hãy đợi hoàn tất rồi chạy lại kiểm tra."
          }
        }
      }
    },
    "PinDrop is controlling the session.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم PinDrop في الجلسة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop contrôle la session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop steuert die Sitzung."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop שולט בסשן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropがセッションを制御しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 正在控制会话。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop está controlando la sesión."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 正在控制工作階段。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop đang điều khiển phiên."
          }
        }
      }
    },
    "PinDrop is intended for location-based app development and testing on your own device.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop مخصص لتطوير التطبيقات المعتمدة على الموقع واختبارها على جهازك الخاص."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop est destiné au développement et au test d’apps de géolocalisation sur votre propre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop ist für die Entwicklung und das Testen standortbasierter Apps auf Ihrem eigenen Gerät gedacht."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop מיועד לפיתוח ובדיקה של אפליקציות מבוססות מיקום במכשיר שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropは、ご自身のデバイスで位置情報アプリの開発とテストを行うためのものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 旨在用于在您自己的设备上开发和测试基于位置的 App。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop está pensado para el desarrollo y las pruebas de apps basadas en la ubicación en tu propio dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 旨在用於在您自己的裝置上開發和測試基於位置的 App。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop dành cho việc phát triển và thử nghiệm ứng dụng dựa trên vị trí trên thiết bị của chính bạn."
          }
        }
      }
    },
    "PinDrop is preparing the secure device session.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم PinDrop بتجهيز جلسة الجهاز الآمنة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop prépare la session sécurisée de l’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop bereitet die sichere Gerätesitzung vor."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop מכין את סשן המכשיר המאובטח."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropが安全なデバイスセッションを準備しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 正在准备安全的设备会话。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop está preparando la sesión segura del dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 正在準備安全的裝置工作階段。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop đang chuẩn bị phiên thiết bị bảo mật."
          }
        }
      }
    },
    "PinDrop is visible to the iOS pairing screen.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop ظاهر في شاشة إقران iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop est visible dans l’écran d’association d’iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop ist im iOS-Kopplungsbildschirm sichtbar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop גלוי במסך הצימוד של iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropはiOSのペアリング画面に表示されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 已显示在 iOS 配对界面中。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop es visible en la pantalla de emparejamiento de iOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 已顯示在 iOS 配對畫面中。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop hiển thị trên màn hình ghép đôi của iOS."
          }
        }
      }
    },
    "PinDrop lost the location session details.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقد PinDrop تفاصيل جلسة الموقع."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop a perdu les détails de la session de localisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop hat die Details der Standortsitzung verloren."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop איבד את פרטי סשן המיקום."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropは位置情報セッションの詳細を失いました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 丢失了定位会话的详细信息。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop perdió los detalles de la sesión de ubicación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 遺失了定位工作階段的詳細資料。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop đã mất thông tin chi tiết của phiên vị trí."
          }
        }
      }
    },
    "PinDrop needs one private pairing before it can control location. We'll guide you through it next.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج PinDrop إلى إقران خاص واحد قبل أن يتحكم في الموقع. سنرشدك خلاله في الخطوة التالية."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop a besoin d’une association privée avant de pouvoir contrôler la position. Nous vous guidons juste après."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop benötigt einmalig eine private Kopplung, bevor es den Standort steuern kann. Wir führen Sie gleich durch den Vorgang."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop זקוק לצימוד פרטי אחד לפני שיוכל לשלוט במיקום. נדריך אותך בכך בשלב הבא."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropが位置情報を操作するには、一度だけプライベートなペアリングが必要です。次の画面でご案内します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 需要先完成一次私密配对，才能控制位置。接下来我们会引导您完成。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop necesita un emparejamiento privado antes de poder controlar la ubicación. Te guiaremos a continuación."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 需要先完成一次私密配對，才能控制位置。接下來我們會引導您完成。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop cần một lần ghép đôi riêng tư trước khi có thể điều khiển vị trí. Chúng tôi sẽ hướng dẫn bạn ở bước tiếp theo."
          }
        }
      }
    },
    "PinDrop sends only a small, fixed set of anonymous activity counts when sharing is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل PinDrop مجموعة صغيرة ثابتة فقط من أعداد النشاط المجهولة عند تفعيل المشاركة."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop n’envoie qu’un petit ensemble fixe de compteurs d’activité anonymes lorsque le partage est activé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop sendet nur einen kleinen, festen Satz anonymer Aktivitätszählungen, wenn das Teilen aktiviert ist."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop שולח רק קבוצה קטנה וקבועה של ספירות פעילות אנונימיות כשהשיתוף מופעל."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有が有効な場合、PinDropは固定された少数の匿名アクティビティ数のみを送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用共享后，PinDrop 仅发送一小组固定的匿名活动计数。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop solo envía un pequeño conjunto fijo de recuentos de actividad anónimos cuando el uso compartido está activado."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用分享後，PinDrop 僅傳送一小組固定的匿名活動計數。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop chỉ gửi một tập nhỏ cố định các số liệu hoạt động ẩn danh khi bật chia sẻ."
          }
        }
      }
    },
    "PinDrop should continue automatically. If it doesn't, tap Continue.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يتابع PinDrop تلقائيًا. إن لم يحدث ذلك، فاضغط على «متابعة»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop devrait continuer automatiquement. Sinon, touchez Continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop sollte automatisch fortfahren. Falls nicht, tippen Sie auf „Fortfahren“."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop אמור להמשיך אוטומטית. אם לא, הקש על ״המשך״."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropは自動的に続行します。続行しない場合は「続ける」をタップしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 应会自动继续。如果没有，请点按“继续”。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop debería continuar automáticamente. Si no, toca Continuar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 應會自動繼續。若沒有，請點一下「繼續」。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop sẽ tự động tiếp tục. Nếu không, hãy nhấn Tiếp tục."
          }
        }
      }
    },
    "PinDrop uses a narrow first-party sender instead of an analytics SDK, so extra device metadata cannot be added automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم PinDrop مُرسِلًا ضيق النطاق من جهة أولى بدلًا من حزمة تحليلات، لذا لا يمكن إضافة بيانات وصفية إضافية للجهاز تلقائيًا."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop utilise un émetteur interne restreint plutôt qu’un SDK d’analyse, si bien qu’aucune métadonnée supplémentaire de l’appareil ne peut être ajoutée automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop nutzt einen schmalen eigenen Sender statt eines Analyse-SDK, sodass keine zusätzlichen Gerätemetadaten automatisch hinzugefügt werden können."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop משתמש בשולח צר של צד ראשון במקום ב‑SDK של אנליטיקה, כך שלא ניתן להוסיף אוטומטית מטא‑נתוני מכשיר נוספים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDropは分析SDKではなく限定的な自社の送信機能を使っているため、デバイスの追加メタデータが自動的に付加されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 使用精简的自研发送器，而非分析 SDK，因此不会自动附加额外的设备元数据。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop usa un emisor propio muy acotado en lugar de un SDK de analítica, por lo que no se pueden añadir automáticamente metadatos adicionales del dispositivo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 使用精簡的自行開發傳送器，而非分析 SDK，因此不會自動附加額外的裝置中繼資料。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop dùng một bộ gửi nội bộ hẹp thay vì SDK phân tích, nên không thể tự động thêm siêu dữ liệu thiết bị bổ sung."
          }
        }
      }
    },
    "PinDrop will need a new RPPairing file before it can connect again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحتاج PinDrop إلى ملف RPPairing جديد قبل أن يتمكن من الاتصال مرة أخرى."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop aura besoin d’un nouveau fichier RPPairing pour se reconnecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop benötigt eine neue RPPairing-Datei, bevor es sich wieder verbinden kann."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop יצטרך קובץ RPPairing חדש לפני שיוכל להתחבר שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再び接続するには、PinDropに新しいRPPairingファイルが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 需要新的 RPPairing 文件才能再次连接。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop necesitará un nuevo archivo RPPairing para volver a conectarse."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop 需要新的 RPPairing 檔案才能再次連線。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop sẽ cần tệp RPPairing mới trước khi có thể kết nối lại."
          }
        }
      }
    },
    "PinDrop will return automatically after the tunnel starts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعود PinDrop تلقائيًا بعد بدء النفق."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop reviendra automatiquement une fois le tunnel démarré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop kehrt automatisch zurück, sobald der Tunnel gestartet ist."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop יחזור אוטומטית לאחר שהמנהרה תופעל."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トンネルが開始されると、PinDropは自動的に戻ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道启动后，PinDrop 会自动返回。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PinDrop volverá automáticamente cuando se inicie el túnel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通道啟動後，PinDrop 會自動返回。"
          }
        },
        "vi": {
