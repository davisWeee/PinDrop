        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào bản đồ"
          }
        }
      }
    },
    "TelemetryDeck says it does not store IP addresses. Anonymous events may be retained for roughly 7–10 years, with no guaranteed exact deletion date.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكر TelemetryDeck أنها لا تخزّن عناوين IP. قد يتم الاحتفاظ بالأحداث المجهولة لمدة 7–10 سنوات تقريبًا دون تاريخ حذف دقيق مضمون."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TelemetryDeck indique ne pas stocker d’adresses IP. Les événements anonymes peuvent être conservés environ 7 à 10 ans, sans date de suppression exacte garantie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TelemetryDeck gibt an, keine IP-Adressen zu speichern. Anonyme Ereignisse können etwa 7–10 Jahre aufbewahrt werden, ohne garantiertes genaues Löschdatum."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TelemetryDeck מצהירה שאינה שומרת כתובות IP. אירועים אנונימיים עשויים להישמר כ‑7–10 שנים, ללא תאריך מחיקה מדויק מובטח."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TelemetryDeckはIPアドレスを保存しないとしています。匿名イベントは7〜10年ほど保持される場合があり、正確な削除日は保証されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TelemetryDeck 表示不会存储 IP 地址。匿名事件可能保留约 7–10 年，且不保证确切的删除日期。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TelemetryDeck indica que no almacena direcciones IP. Los eventos anónimos pueden conservarse unos 7–10 años, sin una fecha de eliminación exacta garantizada."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TelemetryDeck 表示不會儲存 IP 位址。匿名事件可能保留約 7–10 年，且不保證確切的刪除日期。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TelemetryDeck cho biết họ không lưu địa chỉ IP. Các sự kiện ẩn danh có thể được giữ khoảng 7–10 năm, không đảm bảo ngày xóa chính xác."
          }
        }
      }
    },
