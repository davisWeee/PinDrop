    "Pair this iPhone before restoring its real location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرن هذا الـ iPhone قبل استعادة موقعه الحقيقي."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez cet iPhone avant de restaurer sa position réelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie dieses iPhone, bevor Sie den echten Standort wiederherstellen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צמד את ה‑iPhone הזה לפני שחזור המיקום האמיתי שלו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の位置情報を復元する前に、このiPhoneをペアリングしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复真实位置之前，请先配对这台 iPhone。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja este iPhone antes de restaurar su ubicación real."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復真實位置之前，請先配對這部 iPhone。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy ghép đôi iPhone này trước khi khôi phục vị trí thật."
          }
        }
      }
    },
