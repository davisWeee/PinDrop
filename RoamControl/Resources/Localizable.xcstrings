    "Drop a precise pin anywhere on the map. The close button on its card clears that pin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسقط دبوسًا دقيقًا في أي مكان على الخريطة. يؤدي زر الإغلاق على بطاقته إلى مسح الدبوس."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez une épingle précise n’importe où sur la carte. Le bouton de fermeture de sa carte efface l’épingle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie eine präzise Stecknadel an eine beliebige Stelle der Karte. Mit der Schließen-Taste auf ihrer Karte entfernen Sie sie wieder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנח סיכה מדויקת בכל מקום במפה. לחצן הסגירה בכרטיס שלה מנקה את הסיכה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図上の好きな場所に正確なピンを置けます。カードの閉じるボタンでピンを消去できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在地图上任意位置放置精确的大头针。点按其卡片上的关闭按钮即可清除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca una chincheta precisa en cualquier punto del mapa. El botón de cerrar de su tarjeta la borra."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在地圖上任意位置放置精確的大頭針。點一下其卡片上的關閉按鈕即可清除。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả một ghim chính xác ở bất kỳ đâu trên bản đồ. Nút đóng trên thẻ của nó sẽ xóa ghim."
          }
        }
      }
    },
