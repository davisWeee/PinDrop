          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生的配對身分無效。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh tính ghép đôi được tạo không hợp lệ."
          }
        }
      }
    },
    "The handshake worked. Saving its keys securely.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نجحت المصافحة. جارٍ حفظ مفاتيحها بأمان."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La négociation a réussi. Enregistrement sécurisé des clés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Handshake war erfolgreich. Die Schlüssel werden sicher gespeichert."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחיצת היד הצליחה. שומר את המפתחות בצורה מאובטחת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドシェイクに成功しました。キーを安全に保存しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "握手成功，正在安全保存密钥。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El protocolo funcionó. Guardando las claves de forma segura."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "握手成功，正在安全儲存金鑰。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt tay thành công. Đang lưu khóa một cách an toàn."
          }
        }
      }
    },
    "The iPhone could not finish pairing.": {
      "extractionState": "manual",
